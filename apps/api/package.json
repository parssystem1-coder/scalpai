{
  "name": "@scalpai/app-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "npx turbo run build --filter=@scalpai/app-api^... && npx tsc -p tsconfig.json && mkdir -p dist && echo '{\"status\":\"ok\",\"service\":\"scalpai-api\"}' > dist/index.html",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "npm run build && node dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "^2.0.2",
    "@scalpai/analysis-core": "*",
    "@scalpai/db": "*",
    "@scalpai/shared": "*",
    "@scalpai/sync-client": "*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^26.3.0",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3"
  }
}