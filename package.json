{
  "name": "scalpai",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Scalp & Hair Analysis System",
  "author": "ScalpAI Team",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "cross-env BUILD_MODE=prod tsc -b && cross-env BUILD_MODE=prod vite build",
    "build:prod": "cross-env BUILD_MODE=prod vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db-contract.cjs",
    "test:all": "vitest run && node scripts/test-db-contract.cjs && node scripts/check-shared-constants.cjs",
    "verify": "tsc -b && eslint . && vitest run && node scripts/test-db-contract.cjs && node scripts/check-shared-constants.cjs",
    "install-deps": "pnpm install",
    "rebuild:native": "node scripts/rebuild-native.cjs",
    "electron": "cross-env BUILD_MODE=prod pnpm run build && electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "cross-env BUILD_MODE=prod pnpm run build && electron-builder",
    "build:python:win": "powershell -ExecutionPolicy Bypass -File scripts/build-python-analyzer.ps1",
    "electron:build:win": "cross-env BUILD_MODE=prod pnpm run build && electron-builder --win",
    "electron:build:win:standalone": "pnpm run build:python:win && pnpm run electron:build:win",
    "electron:build:mac": "cross-env BUILD_MODE=prod pnpm run build && electron-builder --mac",
    "electron:build:linux": "cross-env BUILD_MODE=prod pnpm run build && electron-builder --linux",
    "build:dev": "tsc -b && vite build",
    "electron:prod": "cross-env BUILD_MODE=prod pnpm run build && electron .",
    "test:constants": "node scripts/check-shared-constants.cjs",
    "electron:nobuild": "electron ."
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "better-sqlite3": "13.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.0.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.364.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6",
    "recharts": "^2.12.4",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "42.7.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vite-plugin-source-identifier": "1.1.2",
    "vitest": "^2",
    "wait-on": "^7.2.0"
  }
}
