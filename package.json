{
  "name": "scalpai-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "conformance": "tsx tools/conformance/run.ts",
    "graph": "tsx tools/graph/extract.ts",
    "db:migrate": "tsx packages/db/src/migrate-cli.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "e2e": "pnpm db:migrate && pnpm db:seed && playwright test",
    "prepare": "husky",
    "db:seed:gallery": "tsx packages/db/scripts/seed-gallery.ts",
    "budget:bundle": "tsx tools/bundle-budget.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@vitest/coverage-v8": "^4.1.11"
  }
}
