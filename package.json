{
  "name": "scalpai-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "npm run dev --workspace=@scalpai/app-web",
    "build": "npm exec -- turbo run build",
    "build:vercel": "npm exec -- turbo run build --filter=@scalpai/app-web... && rm -rf dist && cp -r apps/web/dist dist",
    "typecheck": "npm exec -- turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx packages/db/src/migrate-cli.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "plans:admin": "tsx packages/db/src/plans-admin.ts",
    "budget:bundle": "tsx tools/bundle-budget.ts",
    "conformance": "tsx tools/conformance/run.ts",
    "graph": "tsx tools/graph/extract.ts",
    "ops:validate": "docker compose -f ops/prod.yml --env-file ops/prod.env config -q",
    "ops:up": "docker compose -f ops/prod.yml --env-file ops/prod.env up -d --build --wait"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.16.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^26.3.0",
    "@types/three": "^0.185.4",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ]
}
