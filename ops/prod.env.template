# ScalpAI Self-Hosted production environment (copy to ops/prod.env)
#
# Nothing here has a default. If a value is missing, `docker compose` refuses
# to start instead of booting with a shared password (WEAKNESSES C8).
# Keep passwords alphanumeric: they are embedded in a postgres:// URL.
NODE_ENV=production

# ---- Public entrypoint ------------------------------------------------------
# Must be a real, resolvable domain: Let's Encrypt cannot issue for LAN names.
SCALPAI_DOMAIN=clinic.example.com
ACME_EMAIL=admin@example.com

# ---- PostgreSQL -------------------------------------------------------------
# Owner role: used ONLY by the one-shot `migrate` service.
POSTGRES_USER=scalpai_owner
POSTGRES_PASSWORD=replace_with_strong_password_32chars_min
POSTGRES_DB=scalpai
# Runtime role password (scalpai_app). The migration sets it, the API uses it.
APP_ROLE_PASSWORD=replace_with_a_different_strong_password

# ---- MinIO / S3 -------------------------------------------------------------
MINIO_ROOT_USER=scalpai_admin
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password
S3_BUCKET=scalpai-media

# ---- JWT (ADR-0035) ---------------------------------------------------------
# Exactly these names are read by the API. 32+ chars, random.
JWT_SECRET=replace_with_random_64_character_hex_string
# Rotation window: the previous key only VERIFIES, until the timestamp passes.
# JWT_SECRET_PREVIOUS=
# JWT_SECRET_PREVIOUS_UNTIL=2026-01-01T00:00:00Z

# ---- Backups ----------------------------------------------------------------
BACKUP_ENCRYPTION_PASSPHRASE=replace_with_strong_backup_passphrase
