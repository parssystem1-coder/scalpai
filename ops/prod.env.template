# ScalpAI Self-Hosted production environment (copy to ops/prod.env)
#
# Nothing here has a default. If a value is missing, `docker compose` refuses
# to start instead of booting with a shared password (WEAKNESSES C8).
# Keep passwords alphanumeric: they are embedded in a postgres:// URL.
NODE_ENV=production

# ---- Public entrypoint ------------------------------------------------------
# Must be a real, resolvable domain: Let's Encrypt cannot issue for LAN names.
SCALPAI_DOMAIN=clinic.example.com
ACME_EMAIL=admin@example.com

# ---- PostgreSQL -------------------------------------------------------------
# Owner role: used ONLY by the one-shot `migrate` service and by backups.
POSTGRES_USER=scalpai_owner
POSTGRES_PASSWORD=replace_with_strong_password_32chars_min
POSTGRES_DB=scalpai
# Runtime role password (scalpai_app). The migration sets it, the API uses it.
APP_ROLE_PASSWORD=replace_with_a_different_strong_password

# ---- MinIO / S3 -------------------------------------------------------------
MINIO_ROOT_USER=scalpai_admin
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password
S3_BUCKET=scalpai-media

# ---- JWT (ADR-0035) ---------------------------------------------------------
# Exactly these names are read by the API. 32+ chars, random.
JWT_SECRET=replace_with_random_64_character_hex_string
# Rotation window: the previous key only VERIFIES, until the timestamp passes.
# JWT_SECRET_PREVIOUS=
# JWT_SECRET_PREVIOUS_UNTIL=2026-01-01T00:00:00Z

# ---- Backups (ADR-0042) -----------------------------------------------------
# Encryption is age (X25519 + ChaCha20-Poly1305). There is NO passphrase:
# the host that writes backups only holds the PUBLIC recipients file, so a
# compromised clinic host cannot read its own backup history.
#
#   age-keygen -o scalpai-backup-identity.txt          # keep OFF this host
#   grep 'public key' scalpai-backup-identity.txt      # -> age1...
#   printf 'age1...\n' | sudo tee /etc/scalpai/backup-recipients.txt
#   sudo chmod 0444 /etc/scalpai/backup-recipients.txt
#
# Absolute path: it is mounted into the backup container at the same path.
BACKUP_AGE_RECIPIENTS_FILE=/etc/scalpai/backup-recipients.txt
# Local snapshots are pruned after this many days.
BACKUP_RETENTION_DAYS=14
# BACKUP_CRON=0 2 * * *

# Off-site, object-locked copy. Enable object locking on the bucket when you
# create it (`mc mb --with-lock`, or "Object Lock" on the provider side) -
# otherwise the retention lock fails and the backup run fails with it.
BACKUP_OFFSITE_ENDPOINT=https://s3.provider.example
BACKUP_OFFSITE_BUCKET=scalpai-offsite
BACKUP_OFFSITE_ACCESS_KEY=replace_with_offsite_access_key
BACKUP_OFFSITE_SECRET_KEY=replace_with_offsite_secret_key
BACKUP_OFFSITE_RETENTION_DAYS=90
# COMPLIANCE (nobody can shorten it) or GOVERNANCE (a privileged user can).
BACKUP_OFFSITE_LOCK_MODE=COMPLIANCE

# ---- Operations (ADR-0042) --------------------------------------------------
# Where alerts go: a failed backup, a failed restore drill and every 5xx burst
# POST a scrubbed JSON body here. Required - an install nobody can be paged
# about is a misconfiguration, not a lean deployment.
ALERT_WEBHOOK_URL=https://alerts.example/hooks/scalpai
# ALERT_MIN_SEVERITY=warning
# Prometheus scrape token. Unset => /api/v1/metrics does not exist.
# METRICS_TOKEN=replace_with_random_metrics_token
# Connection pool ceilings - no statement may pin a connection forever.
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
# Request budgets (L4): per clinic, and one global ceiling for the whole box.
# RATE_LIMIT_DEFAULT_MAX=600
# RATE_LIMIT_GLOBAL_MAX=5000
