# ScalpAI Caddyfile - production TLS reverse proxy (ADR-0036)
#
# SCALPAI_DOMAIN and ACME_EMAIL are injected by ops/prod.yml and are REQUIRED:
# automatic HTTPS is on, so the domain must resolve to this host.
# LAN-only installs: replace the `tls` story by adding `tls internal` inside
# the site block and trust Caddy's local CA on the clinic workstations.
{
	email {$ACME_EMAIL}
}

# Explicit HTTP -> HTTPS redirect (no plaintext service on :80).
http://{$SCALPAI_DOMAIN} {
	redir https://{host}{uri} permanent
}

https://{$SCALPAI_DOMAIN} {
	encode zstd gzip

	# The API owns the whole /api/* prefix and serves /api/v1/... itself:
	# stripping the prefix here used to produce 404s for every route.
	handle /api/* {
		reverse_proxy api:3000
	}

	# MinIO presigned media access
	handle /media/* {
		reverse_proxy minio:9000
	}

	# Web SPA frontend
	handle {
		reverse_proxy web:80
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=()"
		-Server
	}
}
