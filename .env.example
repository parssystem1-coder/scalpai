# ──────────────────────────────────────────────────────────────
# ScalpAI v2 — Environment Variables
# Copy this file to `.env` and fill in the values for your environment.
# Never commit `.env` to version control.
# ──────────────────────────────────────────────────────────────

# ── Node / Runtime ───────────────────────────────────────────
NODE_ENV=development

# ── Frontend (Vite) ──────────────────────────────────────────
# Base URL for the API from the browser. Defaults to "/api/v1" in dev.
VITE_API_URL=/api/v1

# ── Database ─────────────────────────────────────────────────
# Superuser connection string for migrations and seeding (required).
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scalpai

# Application-role connection string (used at runtime by the API).
DATABASE_URL=postgresql://scalpai_app:CHANGE_ME@localhost:5432/scalpai

# Individual connection params (alternative to DATABASE_URL).
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=scalpai_app
SQL_PASSWORD=CHANGE_ME
SQL_DB_NAME=scalpai

# Admin/superuser credentials (for migrate/seed CLI only).
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres

# Password for the scalpai_app role created by migration.
APP_ROLE_PASSWORD=CHANGE_ME

# ── JWT / Auth ───────────────────────────────────────────────
# Required: minimum 32 characters. Boot fails if missing.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Optional: previous secret for rotation window.
# JWT_SECRET_PREVIOUS=

JWT_ISSUER=scalpai
JWT_AUDIENCE=scalpai-api
JWT_KID=scalpai-v1
JWT_ACCESS_TTL=15m

# ── Auth Throttling ─────────────────────────────────────────
AUTH_LOCK_MS=60000
AUTH_LOCK_MAX_MS=900000
AUTH_IP_MAX=20
IP_WINDOW_MS=60000
AUTH_REFRESH_IP_MAX=60
AUTH_REFRESH_IP_WINDOW_MS=60000
AUTH_LOGOUT_IP_MAX=60
AUTH_LOGOUT_IP_WINDOW_MS=60000
AUTH_PRINCIPAL_TTL_MS=30000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (required in production).
# Example: https://app.scalpai.com,https://admin.scalpai.com
CORS_ALLOWED_ORIGINS=

# ── Cookies ──────────────────────────────────────────────────
# Override the Secure flag on refresh cookies. Defaults to true in production.
# COOKIE_SECURE=false

# ── Swagger ──────────────────────────────────────────────────
# Enable Swagger docs in production (default: false).
# SWAGGER_ENABLED=false
# Bearer token to protect the Swagger endpoint.
# SWAGGER_TOKEN=

# ── Storage ──────────────────────────────────────────────────
# "s3" for MinIO/S3, "mock" for dev/test local disk.
STORAGE_DRIVER=mock

# S3 / MinIO (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=scalpai-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-dev-only
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Mock storage (used when STORAGE_DRIVER=mock)
LOCAL_STORAGE_DIR=.local-storage
MOCK_S3_PUBLIC_URL=http://127.0.0.1:3000

# ── Seed ─────────────────────────────────────────────────────
# Password used for seed users in dev/test.
SEED_PASSWORD=Dev12345!

# ── Desktop ──────────────────────────────────────────────────
# SCALPAI_API_URL=http://localhost:3001/api

# ── Testing ──────────────────────────────────────────────────
# Set by CI; do not set manually.
# CI=true
