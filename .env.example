# ──────────────────────────────────────────────────────
# ScalpAI v2 — Environment Variables
# Copy this file to `.env` and fill in the values for your environment.
# Never commit `.env` to version control.
# ──────────────────────────────────────────────────────

# ── Node / Runtime ───────────────────────────────────────
NODE_ENV=development

# ── Frontend (Vite) ─────────────────────────────────────
# Base URL for the API from the browser. Defaults to "/api/v1" in dev.
VITE_API_URL=/api/v1

# ── Database ───────────────────────────────────────────
# Superuser connection string for migrations and seeding (required).
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scalpai

# Application-role connection string (used at runtime by the API).
DATABASE_URL=postgresql://scalpai_app:CHANGE_ME@localhost:5432/scalpai

# Individual connection params (alternative to DATABASE_URL).
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=scalpai_app
SQL_PASSWORD=CHANGE_ME
SQL_DB_NAME=scalpai

# Admin/superuser credentials (for migrate/seed CLI only).
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres

# Password for the scalpai_app role created by migration.
APP_ROLE_PASSWORD=CHANGE_ME

# ── Shared state ─ Redis (ADR-0034) ──────────────────────────
# Auth throttling, the principal cache, the entitlement cache and the endpoint
# rate limits are shared here. REQUIRED in production (boot fails without it);
# a single-process dev run may leave it empty and fall back to in-process state.
# TLS is out of scope on purpose — use redis:// on a private network.
REDIS_URL=redis://localhost:6379
# Key prefix, defaults to NODE_ENV. Two deployments may share one Redis only
# with different namespaces.
# REDIS_NAMESPACE=
# REDIS_CONNECT_TIMEOUT_MS=1500
# REDIS_COMMAND_TIMEOUT_MS=1500

# ── JWT / Auth ──────────────────────────────────────────
# Required: minimum 32 characters. Boot fails if missing.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Rotation window (ADR-0035): the previous key only VERIFIES, and only while
# JWT_SECRET_PREVIOUS_UNTIL has not passed. `kid` is derived from each key
# (sha256 prefix) — there is no manual kid to keep in sync.
# JWT_SECRET_PREVIOUS=
# JWT_SECRET_PREVIOUS_UNTIL=2026-09-06T18:00:00Z

JWT_ISSUER=scalpai
JWT_AUDIENCE=scalpai-api
JWT_ACCESS_TTL=15m

# ── Auth Throttling ────────────────────────────────────
AUTH_LOCK_MS=60000
AUTH_LOCK_MAX_MS=900000
# How long consecutive failures keep counting toward the progressive lock.
AUTH_FAIL_WINDOW_MS=900000
AUTH_IP_MAX=20
# Canonical name for the login IP window (there is no IP_WINDOW_MS anymore).
AUTH_IP_WINDOW_MS=60000
AUTH_REFRESH_IP_MAX=60
AUTH_REFRESH_IP_WINDOW_MS=60000
AUTH_LOGOUT_IP_MAX=60
AUTH_LOGOUT_IP_WINDOW_MS=60000
AUTH_PRINCIPAL_TTL_MS=30000

# ── Entitlement cache ──────────────────────────────────
ENTITLEMENT_CACHE_TTL_MS=60000

# ── Per-clinic rate limits (WEAKNESSES L4) ─────────────────────
# Requests per window per clinic. 0 disables a bucket. Defaults live in code.
RATE_LIMIT_SYNC_PUSH_MAX=240
RATE_LIMIT_SYNC_PUSH_WINDOW_MS=60000
RATE_LIMIT_SYNC_PULL_MAX=300
RATE_LIMIT_SYNC_PULL_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=120
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_ANALYSIS_MAX=120
RATE_LIMIT_ANALYSIS_WINDOW_MS=60000

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed origins (required in production).
# Example: https://app.scalpai.com,https://admin.scalpai.com
CORS_ALLOWED_ORIGINS=

# ── Cookies ──────────────────────────────────────────
# Override the Secure flag on refresh cookies. Defaults to true in production.
# COOKIE_SECURE=false

# ── Swagger ──────────────────────────────────────────
# Enable Swagger docs in production (default: false).
# SWAGGER_ENABLED=false
# Bearer token to protect the Swagger endpoint.
# SWAGGER_TOKEN=

# ── Storage ──────────────────────────────────────────
# "s3" for MinIO/S3, "mock" for dev/test local disk.
STORAGE_DRIVER=mock

# S3 / MinIO (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=scalpai-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-dev-only
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Mock storage (used when STORAGE_DRIVER=mock)
LOCAL_STORAGE_DIR=.local-storage
MOCK_S3_PUBLIC_URL=http://127.0.0.1:3000

# ── Seed ─────────────────────────────────────────────
# Password used for seed users in dev/test.
SEED_PASSWORD=Dev12345!

# ── Desktop ──────────────────────────────────────────
# SCALPAI_API_URL=http://localhost:3001/api

# ── Testing ──────────────────────────────────────────
# Set by CI; do not set manually.
# CI=true
# Redis instance the KV contract suite runs against (CI sets it).
# REDIS_TEST_URL=redis://127.0.0.1:6379
