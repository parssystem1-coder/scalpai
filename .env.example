# ──────────────────────────────────────────────────────
# ScalpAI v2 — Environment Variables
# Copy this file to `.env` and fill in the values for your environment.
# Never commit `.env` to version control.
# ──────────────────────────────────────────────────────

# ── Node / Runtime ───────────────────────────────────────
NODE_ENV=development

# ── Frontend (Vite) ─────────────────────────────────────
VITE_API_URL=/api/v1

# ── Database ───────────────────────────────────────────
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scalpai
DATABASE_URL=postgresql://scalpai_app:CHANGE_ME@localhost:5432/scalpai
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=scalpai_app
SQL_PASSWORD=CHANGE_ME
SQL_DB_NAME=scalpai
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres
APP_ROLE_PASSWORD=CHANGE_ME
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=35000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
DB_APPLICATION_NAME=scalpai-api

# ── Shared state ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_NAMESPACE=
# REDIS_CONNECT_TIMEOUT_MS=1500
# REDIS_COMMAND_TIMEOUT_MS=1500

# ── JWT / Auth ──────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# JWT_SECRET_PREVIOUS=
# JWT_SECRET_PREVIOUS_UNTIL=2026-09-06T18:00:00Z
JWT_ISSUER=scalpai
JWT_AUDIENCE=scalpai-api
JWT_ACCESS_TTL=15m
AUTH_LOCK_MS=60000
AUTH_LOCK_MAX_MS=900000
AUTH_FAIL_WINDOW_MS=900000
AUTH_IP_MAX=20
AUTH_IP_WINDOW_MS=60000
AUTH_REFRESH_IP_MAX=60
AUTH_REFRESH_IP_WINDOW_MS=60000
AUTH_LOGOUT_IP_MAX=60
AUTH_LOGOUT_IP_WINDOW_MS=60000
AUTH_PRINCIPAL_TTL_MS=30000
ENTITLEMENT_CACHE_TTL_MS=60000
RATE_LIMIT_DEFAULT_MAX=600
RATE_LIMIT_DEFAULT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=5000
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_SYNC_PUSH_MAX=240
RATE_LIMIT_SYNC_PUSH_WINDOW_MS=60000
RATE_LIMIT_SYNC_PULL_MAX=300
RATE_LIMIT_SYNC_PULL_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=120
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_ANALYSIS_MAX=120
RATE_LIMIT_ANALYSIS_WINDOW_MS=60000

# ── PHI encryption and evidence (ADR-0038) ─────────────
# Production must use PHI_KEY_RING_FILE with a mounted secret. Inline is for dev/CI only.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PHI_KEY_RING='[{"kid":"k2026a","key":"BASE64_32_BYTES","state":"active","createdAt":"2026-09-01T00:00:00.000Z"}]'
# PHI_KEY_RING_FILE=/run/secrets/scalpai_phi_key_ring.json
PHI_KEY_MAX_AGE_DAYS=180
# REPORT_SEAL_PRIVATE_KEY_FILE=/run/secrets/scalpai_report_seal_ed25519.pem
# REPORT_SEAL_PUBLIC_KEY_FILE=/run/secrets/scalpai_report_seal_ed25519.pub.pem
# REPORT_SEAL_VERIFY_URL=https://verify.example/consent
# AUDIT_ANCHOR_SIGNING_KEY_FILE=/run/secrets/scalpai_audit_anchor_ed25519.pem
# AUDIT_ANCHOR_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# AUDIT_ANCHOR_WORM_DIR=/var/lib/scalpai/audit-anchors

# ── Operations (ADR-0042) ────────────────────────────────
# Production requires ALERT_WEBHOOK_URL. Test/dev may omit it.
ALERT_WEBHOOK_URL=https://alerts.example/hooks/scalpai
# ALERT_MIN_SEVERITY=warning
# METRICS_TOKEN=replace_with_random_metrics_token
# ALERT_DEDUPE_MS=300000
# ALERT_TIMEOUT_MS=5000
# BACKUP_AGE_RECIPIENTS_FILE=/etc/scalpai/backup-recipients.txt
# BACKUP_AGE_IDENTITY_FILE=/run/secrets/scalpai_backup_identity
# DRILL_REPORT_HMAC_KEY_FILE=/run/secrets/scalpai_drill_report.key
